[Unit]
Description=Webhooks
After=network.target

[Service]
User=deploy
Group=deploy
WorkingDirectory=/opt/homepage/homepage
ExecStart=/opt/homepage/homepage/webhooks
StateDirectory=data
Environment=ACTIVITIES_DB_PATH=/var/lib/data/activities.db
EnvironmentFile=/etc/webhooks/webhooks.env
Restart=on-failure
RestartSec=3

StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
