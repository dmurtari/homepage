[Unit]
Description=My homepage
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
Environment=PHOTO_DIR=/var/www/photos
Environment=MEDIA_BASE_URL=https://media.murtari.me
WorkingDirectory=/opt/homepage/homepage
ExecStart=/opt/homepage/homepage/app
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
