{{ define "page:title" }}Domenic | Apps{{ end }}

{{ define "page:head" }}
<link rel="stylesheet" href="/static/css/apps.css" />
{{ end }}

{{ define "page:content" }}
<div class="layout--column-center">
	<main >
		<section class="app">
			<img src="/static/img/apps/manytime/icon.png" alt="ManyTime Icon" height="256" width="256"/>
			<h1>ManyTime</h1>
			<p>
				<b>ManyTime</b> is a macOS menu bar application that lets you visualize times in different timezones. Created because I wanted a simple way to figure out times, and nothing I could find quite did it in the way that I wanted.
			</p>
			<p>Available via homebrew:</p>
		{{/* gotmplfmt-ignore-start */}}
<pre><code>brew tap dmurtari/tap
brew install --cask dmurtari/tap/manytime
</code></pre>
    {{/* gotmplfmt-ignore-end */}}
			<h2>
				Screenshots
			</h2>
			<div class="app__screenshots">
				<div class="screenshot">
					<img
						class="visible-dark-mode"
						src="/static/img/apps/manytime/window-dark.png"
						alt="Dark Mode Screenshot"
						height="858"
						width="756"
					/>
					<img
						class="visible-light-mode"
						src="/static/img/apps/manytime/window-light.png"
						alt="Light Mode Screenshot"
						height="858"
						width="756"
					/>
				</div>
				<div class="screenshot">
					<img
						class="visible-dark-mode"
						src="/static/img/apps/manytime/settings-dark.png"
						alt="Dark Mode Settings Screenshot"
						height="1564"
						width="1096"
					/>
					<img
						class="visible-light-mode"
						src="/static/img/apps/manytime/settings-light.png"
						alt="Light Mode Settings Screenshot"
						height="1564"
						width="1096"
					/>
				</div>
				<!-- <div class="screenshot">
				<video disablepictureinpicture height="858" width="756">
					<source src="/static/img/apps/manytime/movie-light.mov" type="video/mov">
					Your browser does not support the video tag
				</video>
			</div> -->
		</div>
		<p>
			Source code: <a href="https://codeberg.org/dmurtari/ManyTime"
				target="_blank"
				rel="noopener noreferrer">
				https://codeberg.org/dmurtari/ManyTime
			</a>
		</p>
	</section>
</main>
</div>
{{ end }}
