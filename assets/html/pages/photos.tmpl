{{ define "page:title" }}Domenic | Photos{{ end }}

{{ define "page:head" }}
<link rel="stylesheet" href="/static/css/photos.css" />
<script type="module" src="/static/js/photos.js"></script>
{{ end }}

{{ define "page:content" }}
<main class="layout--column-center--wide">
	<div id="photos-page">
		{{ template "photos:page" . }}
	</div>
</main>
{{ end }}

{{ define "photos:page" }}
{{ template "photos:toolbar" . }}
{{ if eq .View "slideshow" }}
	{{ template "photos:slideshow" . }}
{{ else }}
	{{ template "photos:gallery" .Photos }}
{{ end }}
{{ end }}

{{ define "photos:toolbar" }}
<div class="toolbar">
	<div class="view-toggle" role="group" aria-label="View mode">
		<a
			href="/photos?view=gallery"
			aria-current="page"
			{{ if eq .View "gallery" }}disabled{{ end }}
			hx-get="/photos?view=gallery"
			hx-target="#photos-page"
			hx-push-url="true"
			class="{{ if eq .View "gallery" }}active{{ end }}">
			Gallery
		</a>
		<a
			href="/photos?view=slideshow"
			aria-current="page"
			{{ if eq .View "slideshow" }}disabled{{ end }}
			hx-get="/photos?view=slideshow"
			hx-target="#photos-page"
			hx-push-url="true"
			class="{{ if eq .View "slideshow" }}active{{ end }}"
		>
			Slideshow
		</a>
	</div>
</div>
{{ end }}

{{ define "photos:gallery" }}
<section class="gallery">
	{{ range $i, $p := . }}
		<div class="gallery__item">
			<div class="image">
				<a href="/photos?view=slideshow&index={{ $i }}"
					hx-get="/photos?view=slideshow&index={{ $i }}"
					hx-target="#photos-page"
					hx-push-url="true">
					<img src="{{ $p.ThumbnailURL }}" alt="{{ $p.Description }}" />
				</a>
			</div>
		</div>
	{{ end }}
</section>
{{ end }}

{{ define "photos:slideshow" }}
<section class="slideshow" id="slideshow">
	{{ template "photos:slideshow:nav" . }}
	{{ template "photos:slideshow:subject" . }}
</section>
{{ end }}

{{ define "photos:slideshow:subject" }}
<div class="slideshow__subject" id="slideshow-subject">
	<img src="{{ .Current.FullSizeURL }}" alt="{{ .Current.Description }}" />
</div>
{{ end }}

{{ define "photos:slideshow:nav" }}
<div class="slideshow__nav">
	<button
		id="scroll-left-button"
		disabled
		class="nav-button"
		aria-label="Scroll slideshow left"
		onclick="scrollNavLeft()">
		&lang;
	</button>
	<div class="slideshow-nav" id="slideshow-nav">
		{{ template "photos:slideshow:nav-items" . }}
	</div>
	<button
		id="scroll-right-button"
		disabled
		class="nav-button"
		aria-label="Scroll slideshow right"
		onclick="scrollNavRight()">
		&rang;
	</button>
</div>
{{ end }}

{{ define "photos:slideshow:nav-items" }}
{{ range $i, $p := .Photos }}
	<a href="/photos?view=slideshow&index={{ $i }}"
		hx-get="/photos?view=slideshow&index={{ $i }}"
		hx-target="#slideshow-subject"
		hx-swap="outerHTML"
		hx-push-url="true"
		class="slideshow__nav-item {{ if eq $i $.Index }}active{{ end }}">
		<img src="{{ $p.ThumbnailURL }}" alt="{{ $p.Description }}" />
	</a>
{{ end }}
{{ end }}

{{ define "photos:slideshow:swap-target" }}
{{ template "photos:slideshow:subject" . }}
<div hx-swap-oob="innerHTML:#slideshow-nav">
	{{ template "photos:slideshow:nav-items" . }}
</div>
{{ end }}
