{{ define "page:title" }}Domenic | {{ .Album.Name }} {{ end }}

{{ define "page:head" }}
<link rel="stylesheet" href="{{ assetHash "/static/css/photos.css" }}" />

<script type="module" src="{{ assetHash "/static/js/photos.js" }}"></script>
{{ end }}

{{ define "page:content" }}
<main class="layout--column-center" id="photos-page">
	{{ template "photos:page" . }}
</main>
{{ end }}

{{ define "photos:page" }}
<header class="layout--column-center photos-header">
	<div class="photos-header__title">
		<h1>
			<a href="/photos">Albums</a> > {{ .Album.Name }}
		</h1>
		<span>({{ len .Album.Photos }} photos)</span>
	</div>

	{{ template "photos:toolbar" . }}
</header>

{{ if eq .View "slideshow" }}
	{{ template "photos:slideshow" . }}
{{ else }}
	{{ template "photos:gallery" . }}
{{ end }}
{{ end }}

{{ define "photos:toolbar" }}
<div class="toolbar">
	<div class="view-toggle" role="group" aria-label="View mode">
		<a
			href="/photos/{{ .Album.ID }}?view=gallery"
			aria-current="page"
			{{ if eq .View "gallery" }}disabled{{ end }}
			hx-get="/photos/{{ .Album.ID }}?view=gallery"
			hx-target="#photos-page"
			hx-push-url="true"
			class="{{ if eq .View "gallery" }}active{{ end }}">
			Gallery
		</a>
		<a
			href="/photos/{{ .Album.ID }}?view=slideshow"
			aria-current="page"
			{{ if eq .View "slideshow" }}disabled{{ end }}
			hx-get="/photos/{{ .Album.ID }}?view=slideshow"
			hx-target="#photos-page"
			hx-push-url="true"
			class="{{ if eq .View "slideshow" }}active{{ end }}"
		>
			Slideshow
		</a>
	</div>
</div>
{{ end }}

{{ define "photos:gallery" }}
<section class="gallery">
	{{ range $i, $p := .Album.Photos }}
		<div class="gallery__item">
			<a
				href="/photos/{{ $.Album.ID }}?view=slideshow&index={{ $i }}"
				hx-get="/photos/{{ $.Album.ID }}?view=slideshow&index={{ $i }}"
				hx-target="#photos-page"
				hx-push-url="true"
			>
				{{ template "photos:picture:thumb" $p }}
			</a>
		</div>
	{{ end }}
</section>
{{ end }}

{{ define "photos:slideshow" }}
<section class="slideshow" id="slideshow">
	{{ template "photos:slideshow:nav" . }}
	{{ template "photos:slideshow:subject" . }}
</section>
{{ end }}

{{ define "photos:slideshow:subject" }}
<div class="slideshow__subject" id="slideshow-subject">
	{{ template "photos:picture:full" .Current }}
</div>
{{ end }}

{{ define "photos:slideshow:nav" }}
<div class="slideshow__nav">
	<button
		id="scroll-left-button"
		disabled
		class="nav-button"
		aria-label="Scroll slideshow left">
		<svg
			xmlns="http://www.w3.org/2000/svg"
			width="9"
			height="26"
			viewBox="0 0 9 26"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round">
			<path d="M6.5 24 2 13 6.5 2" />
		</svg>
	</button>
	<div class="slideshow-nav" id="slideshow-nav">
		{{ template "photos:slideshow:nav-items" . }}
	</div>
	<button
		id="scroll-right-button"
		disabled
		class="nav-button"
		aria-label="Scroll slideshow right">
		<svg
			xmlns="http://www.w3.org/2000/svg"
			width="9"
			height="26"
			viewBox="0 0 9 26"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<path d="m2 24 4.5-11L2 2" />
		</svg>
	</button>
</div>
{{ end }}

{{ define "photos:slideshow:nav-items" }}
{{ range $i, $p := .Album.Photos }}
	<a href="/photos/{{ $.Album.ID }}?view=slideshow&index={{ $i }}"
		hx-get="/photos/{{ $.Album.ID }}?view=slideshow&index={{ $i }}"
		hx-target="#slideshow-subject"
		hx-swap="outerHTML"
		hx-push-url="true"
		class="slideshow__nav-item {{ if eq $i $.Index }}active{{ end }}">
		{{ template "photos:picture:thumb" $p }}
	</a>
{{ end }}
{{ end }}

{{ define "photos:slideshow:swap-target" }}
{{ template "photos:slideshow:subject" . }}
<div hx-swap-oob="innerHTML:#slideshow-nav">
	{{ template "photos:slideshow:nav-items" . }}
</div>
{{ end }}
