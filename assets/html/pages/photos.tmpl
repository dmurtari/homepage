{{ define "page:title" }}Domenic | Photos{{ end }}

{{ define "page:head" }}
<link rel="stylesheet" href="/static/css/photos.css" />
{{ end }}

{{ define "page:content" }}
<main>
	<section class="gallery">
		{{ template "photos:gallery" . }}
	</section>
</main>
{{ end }}

{{ define "photos:gallery" }}
{{ range . }}
	<div class="gallery__item">
		<div class="image">
			<img src="{{ .ThumbnailURL }}" alt="{{ .Description }}" />
		</div>
	</div>
{{ end }}
{{ end }}
